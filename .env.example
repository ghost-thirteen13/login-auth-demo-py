# ===== 登录授权 Demo 环境变量模板 =====
# 用法：复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 忽略，严禁提交进仓库。

# JWT 签名密钥（生产必填）：必须是随机长字符串，否则每次重启后已签发 token 全部失效。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# LLM 审核配置（DeepSeek，OpenAI 兼容接口）。
# 不填 LLM_API_KEY 时，注册审核自动降级为「放行 + 待人工复审」，功能不阻塞。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# seed admin 初始密码（仅首次启动建库时生效；改库需删 data/users.db 重建才再生效）
ADMIN_SEED_PASSWORD=Admin@2026!
